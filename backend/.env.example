# Server
PORT=4000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/listen-together

# Comma-separated list of allowed origins for CORS / Socket.IO
CORS_ORIGIN=http://localhost:5173

# Max members allowed per room
MAX_ROOM_MEMBERS=25

# Room inactivity cleanup (minutes) - rooms with no activity for this long are removed
ROOM_INACTIVITY_MINUTES=180

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Secret for signing session tokens
JWT_SECRET=your-jwt-secret-key-change-in-production
